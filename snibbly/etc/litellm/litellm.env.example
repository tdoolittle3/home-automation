# Copy to /etc/litellm/litellm.env (root:root, mode 600 — systemd reads it as
# root before dropping to the litellm user).

# What clients present on :8080. Set to the SAME value as LLAMA_API_KEY in
# /etc/llama/llama.env so every existing client keeps working unchanged.
# Rotation means editing both files and restarting both services.
LITELLM_MASTER_KEY=replace-me

# What the proxy presents upstream to llama-swap on 127.0.0.1:9292 — must
# match /etc/llama/llama.env.
LLAMA_API_KEY=replace-me

# The snibbly project keys from /opt/stacks/langfuse/.env
# (LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY).
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
# Same box, so loopback — capture keeps working if the LAN is unhappy.
LANGFUSE_HOST=http://127.0.0.1:3000
