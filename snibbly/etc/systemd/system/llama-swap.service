[Unit]
Description=llama-swap model router
After=network-online.target
Wants=network-online.target

[Service]
User=llama
EnvironmentFile=/etc/llama/llama.env
# Loopback since the Langfuse change: the LiteLLM proxy (litellm.service) owns
# 0.0.0.0:8080 and forwards here, so every conversation gets captured.
ExecStart=/opt/llama-swap/llama-swap -config /etc/llama-swap/config.yaml -listen 127.0.0.1:9292 -watch-config
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
