# Copy to .env next to docker-compose.yml (the real .env is gitignored).
# Every value below is a secret minted at deploy time — none of them need to
# match anything else on the network. Generate the random ones with:
#   openssl rand -hex 32
#
# The four datastore passwords only guard traffic inside the compose network
# (nothing is published), but set real ones anyway — a weak password here
# becomes load-bearing the day a port gets published for debugging.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=

# Langfuse crypto. SALT and NEXTAUTH_SECRET: openssl rand -hex 32.
# ENCRYPTION_KEY must be exactly 64 hex chars (32 bytes): openssl rand -hex 32.
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# First-start bootstrap (see the LANGFUSE_INIT_* comment in the compose).
# The two keys are what /etc/litellm/litellm.env points at; Langfuse expects
# the pk-lf-/sk-lf- prefixes. Mint them as:
#   pk-lf-$(openssl rand -hex 16)   and   sk-lf-$(openssl rand -hex 16)
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
# UI login for http://192.168.0.19:3000
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
