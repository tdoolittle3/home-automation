# Copy to .env and fill in real values. .env is gitignored - never commit it.

# SSH access to the server (ladybird / 192.168.0.13)
SSH_USER=thomas
SSH_PW=replace-me

# Camera admin password. Both cameras use the same admin account.
# This is also what Frigate uses for RTSP - it becomes
# FRIGATE_RTSP_PASSWORD in /opt/stacks/frigate/.env on the server.
CAMERA_PW=replace-me

# Uptime Kuma ntfy topic. The topic name is the only secret on ntfy.sh -
# anyone who knows it reads every alert. See docs/uptime-kuma.md.
NTFY_TOPIC=replace-me
