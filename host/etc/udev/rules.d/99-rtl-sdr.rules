# Make the RTL-SDR reachable without root.
#
# Default USB device nodes are root:root 0664, so librtlsdr running as a
# non-root user (or inside a container that drops root) cannot claim the
# device. Hand it to the plugdev group — `thomas` is already a member.
#
# 0bda:2838 = RTL2838 (RTL-SDR Blog V3 and most generic dongles)
# 0bda:2832 = RTL2832U, older revisions
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2838", GROUP="plugdev", MODE="0666", SYMLINK+="rtl_sdr"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="2832", GROUP="plugdev", MODE="0666", SYMLINK+="rtl_sdr"
