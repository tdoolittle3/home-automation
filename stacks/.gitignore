*/.env
# Frigate runtime state (container-owned)
frigate/config/.jwt_secret
frigate/config/*.db*
frigate/config/model_cache/
# Home Assistant runtime state — track only if curated later
home/homeassistant/*
!home/homeassistant/configuration.yaml
!home/homeassistant/automations.yaml
!home/homeassistant/scripts.yaml
!home/homeassistant/scenes.yaml
home/mosquitto/data/
# Jellyfin/Kuma runtime state
media/config/
media/cache/
net/uptime-kuma/
# Immich runtime state — postgres data and the generated .env (see immich/.env.example)
immich/postgres/
net/.venv/
# Push/heartbeat URLs are secrets - they authenticate the beat
net/kuma-push-url.txt
net/kuma-frigate-push-url.txt
net/healthchecks-url.txt
# AdGuard Home runtime state. conf/ holds the LIVE config, which AdGuard
# rewrites on every UI change and which carries the admin password hash -
# the tracked seed is dns/AdGuardHome.yaml. work/ is the query log, the
# statistics database and the downloaded filter lists.
dns/conf/
dns/work/
