# Copy to .env on the server (/opt/stacks/sdr/.env) and fill in real values.
# stacks/.gitignore already covers */.env — never commit the real file.

# ---- Antenna position — REQUIRED, and must be accurate --------------------
# This is the position of the ANTENNA, not the house, and not Loveland's
# city centre. MLAT multilateration solves aircraft positions by comparing
# signal arrival times across many receivers, so a wrong position degrades
# results for every station in the area — aggregators do notice and will
# drop the feed.
#
# Getting the numbers:
#   lat/lon — right-click your antenna's exact spot in Google Maps, click the
#             decimal coordinates at the top of the menu to copy them.
#             Use 5+ decimal places (~1 m precision).
#   alt     — height above MEAN SEA LEVEL of the antenna itself, i.e.
#             ground elevation + how high it is mounted. NOT height above
#             ground. Loveland CO ground is roughly 1520 m / 4985 ft, so a
#             roof-mounted antenna lands near 1528m. Suffix the unit:
#             "1528m" or "5013ft" — a bare number is read as metres.
ADSB_LAT=REPLACE_ME
ADSB_LON=REPLACE_ME
ADSB_ALT=REPLACE_ME

# ---- Dongle ---------------------------------------------------------------
# RTL-SDR Blog V3 ships with serial 00000001. Confirm with `rtl_test -t`.
# Only needs changing if you add a second dongle.
ADSB_SERIAL=00000001

# ---- Station identity -----------------------------------------------------
# Shown on aggregator maps. Alphanumeric, no spaces.
ADSB_STATION_NAME=ladybird

# Optional stable station UUID, keeps your stats linked across rebuilds.
# Generate once with: uuidgen
ADSB_UUID=
