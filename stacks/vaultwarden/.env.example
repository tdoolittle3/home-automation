# Copy to .env and chmod 600. The stack runs fine with no .env at all -
# signups closed, admin panel disabled - which is the steady state.

# Flip to true ONLY to create the first account, then back to false and
# `docker compose up -d` again. docs/vaultwarden.md walks through it.
SIGNUPS_ALLOWED=false

# Uncomment to enable the /admin panel (user management, SMTP tests).
# Generate with: openssl rand -base64 48
# Re-disable when done - the panel can reset any account's 2FA.
#ADMIN_TOKEN=
