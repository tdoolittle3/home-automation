# Hermes Agent config — the homelab "Operator" profile.
# Copy to data/config.yaml on ladybird (or let `hermes setup` write it).
# Secrets (keys, tokens) go in data/.env, NEVER here — see .env.example.
# docs/hermes.md.

# The model lives on snibbly: litellm (:8080) -> llama-swap -> coder-30b, the
# clean (non-abliterated) coder deployed 2026-11-08 at 64k context. Only clean
# models ever drive the agent; heretic/DeepHat models never get tool access.
providers:
  snibbly:
    type: openai
    base_url: "${SNIBBLY_LLM_BASE_URL}"   # .env, e.g. http://192.168.0.19:8080/v1
    # api_key resolves from .env (the litellm master key == LLAMA_API_KEY).
    # Confirm the exact var name Hermes expects for this provider with
    # `hermes setup` — it writes the provider block authoritatively.
    models:
      coder-30b:
        id: "coder-30b"            # the llama-swap model name
        context_length: 65536      # matches the -c 65536 KV cache sized on snibbly

model:
  default: snibbly/coder-30b

# The agent's general shell. CHOOSE AT DEPLOY (docs/hermes.md "Sandbox"):
#   docker — ephemeral containers on ladybird; requires the docker.sock mount in
#            docker-compose.yml (root-equivalent — weigh carefully).
#   ssh    — run commands on a dedicated low-priv sandbox user; upstream's
#            recommended isolation (agent can't read this box's .env or edit its
#            own code). Set TERMINAL_SSH_* in .env.
terminal:
  backend: docker

# Auto-summarize old turns as the 64k window fills, so long multi-step agent
# sessions don't fall off the context cliff mid-task.
compression:
  enabled: true
  threshold: 0.85
