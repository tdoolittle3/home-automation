# Hermes Agent secrets — copy to data/.env on ladybird, chmod 600. Gitignored.
# docs/hermes.md. NEVER commit real values.

# --- host file ownership (so files in ./data stay owned by you) ---
# Set to the ladybird user that owns the stack dir: `id -u` / `id -g`.
HERMES_UID=1000
HERMES_GID=1000

# --- model provider: snibbly litellm -> llama-swap -> coder-30b ---
SNIBBLY_LLM_BASE_URL=http://192.168.0.19:8080/v1
# litellm master key (same VALUE as snibbly /etc/llama/llama.env LLAMA_API_KEY).
# Confirm the exact var name Hermes wants for the "snibbly" provider via
# `hermes setup` (may be SNIBBLY_API_KEY or OPENAI_API_KEY).
SNIBBLY_API_KEY=

# --- Home Assistant plugin (install: hermes plugins install homeassistant) ---
# Create a LIMITED (non-admin) HA user, log in as them, and generate a
# long-lived token from their profile. That user's permissions are the agent's
# actuation ceiling — this is the real safety boundary, not the prompt.
HASS_URL=http://192.168.0.13:8123
HASS_TOKEN=

# --- Telegram gateway (talk to the agent from your phone) ---
# Bot token from @BotFather; lock to your own numeric user id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# --- terminal sandbox (ONLY if config.yaml sets terminal.backend: ssh) ---
# A dedicated low-priv user on a sandbox host keeps agent shell commands away
# from this box's secrets and from editing the agent's own code.
# TERMINAL_SSH_HOST=192.168.0.19
# TERMINAL_SSH_USER=hermes-sandbox
# TERMINAL_SSH_KEY=/opt/data/sandbox_key
