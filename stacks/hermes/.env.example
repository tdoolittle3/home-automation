# Hermes Agent secrets — copy to data/.env on ladybird, chmod 600. Gitignored.
# docs/hermes.md. NEVER commit real values.
# NOTE: docker-compose.yml also loads this file (env_file) so plugins that read
# os.environ (the Home Assistant plugin's HASS_*) see these, not just the model
# client that parses .env itself.

# --- host file ownership (so files in ./data stay owned by you) ---
# Set to the ladybird user that owns the stack dir: `id -u` / `id -g`.
HERMES_UID=1000
HERMES_GID=1000

# --- model provider: snibbly litellm -> llama-swap -> coder-30b ---
# Hermes uses its generic OpenAI provider pointed at litellm via these two vars
# (model.default = openai/coder-30b in config.yaml).
OPENAI_BASE_URL=http://192.168.0.19:8080/v1
# litellm master key (same VALUE as snibbly /etc/llama/llama.env LLAMA_API_KEY).
OPENAI_API_KEY=

# --- Home Assistant plugin ---
# After filling these, ENABLE the plugin (it ships installed-but-disabled):
#   hermes plugins enable homeassistant
# Create a LIMITED (non-admin) HA user, log in as them, and make a long-lived
# token from their profile (/profile/security). That user is the actuation ceiling.
HASS_URL=http://192.168.0.13:8123
HASS_TOKEN=
# Optional entity scoping (comma-separated globs/prefixes) — belt-and-suspenders
# with the non-admin user. Denylist always vetoes; allowlist limits list/read/control.
# HASS_ENTITY_ALLOWLIST=light.*, switch.*, binary_sensor.garage_door
# HASS_ENTITY_DENYLIST=lock.*, alarm_control_panel.*

# --- Telegram gateway (talk to the agent from your phone) ---
# Bot token from @BotFather; lock to your own numeric user id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# --- terminal sandbox (ONLY if config.yaml sets terminal.backend: ssh) ---
# TERMINAL_SSH_HOST=192.168.0.19
# TERMINAL_SSH_USER=hermes-sandbox
# TERMINAL_SSH_KEY=/opt/data/sandbox_key
