# Devbox secrets + identity. Copy to .env (gitignored), fill in, then add the
# real file to Vaultwarden as a file note like every other stack .env
# (docs/vaultwarden.md).

# snibbly's litellm door — OpenAI-compatible, key required. LAN address on
# purpose: bridge containers can't reach tailscale IPs. The key is the same
# LLM_API_KEY the other stacks use (vault / /etc/llama/llama.env on snibbly).
LLM_BASE_URL=http://192.168.0.19:8080/v1
LLM_MODEL=coder-30b
LLM_API_KEY=changeme

# Fine-grained GitHub PAT scoped to ONLY the repos agents may touch
# (Contents: read/write on the chosen repos; nothing org-wide). gh reads it
# straight from the environment — rotation is edit + `docker compose up -d`.
GH_TOKEN=github_pat_changeme

# Commit identity for agent commits — the PERSONAL identity (tdoolittle3),
# never the work one.
GIT_USER_NAME=Thomas Doolittle
GIT_USER_EMAIL=tdoolittle3@gmail.com

# Phone UI port: collie's listen port in the container AND the host loopback
# bind, fronted by `tailscale serve --https=8787` (docs/devbox.md).
COLLIE_PORT=8787

# Optional: pin collie to your tailnet login — it rejects anyone else. Works
# off the identity headers tailscale serve injects.
#COLLIE_TRUSTED_USER=you@example.com

# Optional: private repo for check.sh's token-scope probe (git ls-remote).
#DEVBOX_CHECK_REPO=https://github.com/tdoolittle3/home-dashboard.git
