# Copy to .env on the server and set a real DB_PASSWORD. .env is gitignored.
#   cd /opt/stacks/immich && cp .env.example .env && chmod 600 .env

# Photo and video library. Lives under the storage root so the disk guard sees it.
UPLOAD_LOCATION=/srv/storage/photos

# Postgres data. Deliberately NOT under /srv/storage â€” see the note in
# docker-compose.yml. Relative to this directory, i.e. /opt/stacks/immich/postgres.
DB_DATA_LOCATION=./postgres

TZ=America/Denver

# The Immich version is pinned (tag + digest) in docker-compose.yml, not here — that is
# where Renovate proposes upgrades. Immich ships breaking changes between minors and
# the database image is version-matched: docs/upgrades.md#immich. Leftover
# IMMICH_VERSION lines in a live .env are harmless (nothing reads them).

# Generate with: openssl rand -hex 24
# Letters and digits only â€” Immich requires no special characters here.
DB_PASSWORD=replace-me

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
