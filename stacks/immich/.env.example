# Copy to .env on the server and set a real DB_PASSWORD. .env is gitignored.
#   cd /opt/stacks/immich && cp .env.example .env && chmod 600 .env

# Photo and video library. Lives under the storage root so the disk guard sees it.
UPLOAD_LOCATION=/srv/storage/photos

# Postgres data. Deliberately NOT under /srv/storage — see the note in
# docker-compose.yml. Relative to this directory, i.e. /opt/stacks/immich/postgres.
DB_DATA_LOCATION=./postgres

TZ=America/Denver

# Pinned exactly, not to the floating "v3" tag. Immich ships breaking changes between
# minors and the database image is version-matched; bump both together, deliberately.
IMMICH_VERSION=v3.1.0

# Generate with: openssl rand -hex 24
# Letters and digits only — Immich requires no special characters here.
DB_PASSWORD=replace-me

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
