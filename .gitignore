# ---- Secrets: never commit ----
.env
*.env
!*.env.example
**/.camcreds
**/secrets.yaml
**/.jwt_secret
*.pem
*.key
**/kuma-push-url.txt
**/kuma-push-url-ups.txt
**/kuma-vw-backup-push-url.txt
# n8n's data dir holds the encryption key and every credential
**/n8n-data/
# vaultwarden's data dir IS the vault - db, attachments, JWT signing keys
**/vw-data/

# ---- Runtime state pulled from the server by mistake ----
**/*.db
**/*.db-*
**/model_cache/
**/.storage/

# ---- Local scratch ----
*.tgz
*.tar.gz
*.bak
*.bak.*

# Python scratch
__pycache__/
*.pyc
